[Unit]
Description=Optional TLS ingress for Quant
After=network-online.target hadan-proxy.service
Wants=network-online.target hadan-proxy.service

[Service]
Type=notify
User=hadan-ingress
Group=hadan-ingress
ExecStartPre=/usr/sbin/haproxy -c -f /etc/quant-subscribe-ingress/haproxy.cfg
ExecStart=/usr/sbin/haproxy -Ws -db -f /etc/quant-subscribe-ingress/haproxy.cfg
ExecReload=/usr/sbin/haproxy -c -f /etc/quant-subscribe-ingress/haproxy.cfg
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=128M
TasksMax=64
LimitNOFILE=4096
CPUQuota=50%

[Install]
WantedBy=multi-user.target
