# Copy to .env for local work. Production: /etc/quant-subscribe/hadan.env (root:hadan 0640).
HADAN_ENV=development
HADAN_BASE_URL=http://127.0.0.1:8080
HADAN_DATA_DIR=var
# Production requires >=48 random characters. Local init generates var/.local-secret.
HADAN_SECRET=
HADAN_ADMIN_EMAILS=
# Optional pilot allowlist; empty allows public email registration.
HADAN_ALLOWED_EMAILS=

# No Brevo dependency. Choose a provider with a verified domain and TLS SMTP.
# file = local .eml sink; never use file in production.
# Alibaba DirectMail: SMTP_HOST=smtpdm.aliyun.com, SMTP_PORT=465, SMTP_TLS=implicit.
MAIL_BACKEND=file
MAIL_FROM="Quant <notify@example.invalid>"
# Report email layout: compact (default) or legacy.
HADAN_EMAIL_LAYOUT="compact"
# Public sender address shown on the website; defaults to the address in MAIL_FROM.
MAIL_SENDER=
# Real support contact shown on the terms page. Defaults to MAIL_SENDER if empty.
SUPPORT_CONTACT=
MAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# SES feedback via an SNS HTTPS subscription (bounce/complaint suppression).
SES_FEEDBACK_ENABLED=0
SES_SNS_TOPIC_ARN=
# Alibaba DirectMail feedback via an EventBridge HTTPS target. The target's
# x-eventbridge-signature-token header must equal this 32+ character token.
DIRECTMAIL_FEEDBACK_ENABLED=0
DIRECTMAIL_WEBHOOK_TOKEN=
OTP_HOURLY_BUDGET=60

# Shared scheduling flags belong in hadan.env, visible to main/health/source/ops.
QUANTGT_ENABLED=0
OFFICIAL_MAIL_ENABLED=0
# Optional lightweight inbox polling. 0 disables it; the scheduled official-mail checks still run.
OFFICIAL_MAIL_POLL_SECONDS=0
OPS_AI_ENABLED=0
# Source credentials belong only in source.env on a hardened host.
QUANTGT_EMAIL=
QUANTGT_PASSWORD=
# Optional root-managed matching Chromium executable; sandbox remains enabled.
HADAN_CHROMIUM_EXECUTABLE=
# Original New York/NYSE schedule is default. Override: 08:30:picks,17:00:picks
HADAN_SCHEDULE=
MARKET_EXTRA_HOLIDAYS=

# Dedicated inbox. Official messages must have valid aligned DKIM.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
# latest avoids importing historical mail on first run/UIDVALIDITY change.
IMAP_START_MODE=latest
IMAP_SEARCH=ALL
# Empty by default. Only explicit curators can publish a signed inline forward.
INBOUND_CURATORS=
INBOUND_ADDRESS=
INBOUND_TRIGGER_PICKS=1
OFFICIAL_SENDER_DOMAINS=example.com
STORE_QUARANTINE_RAW=0

# Optional hosted subscription billing. Configure price_id with: hadan product quantgt --mode paid --price-id ...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional one-time CNY payments, disabled until the actual business is approved.
XORPAY_ENABLED=0
XORPAY_APP_ID=
XORPAY_APP_SECRET=
QUANT_PLANS_JSON=[]
# Xiaodou: keep disabled until the merchant, app and each channel are approved.
XIAODOU_ENABLED=0
XIAODOU_BASE_URL=
XIAODOU_APP_ID=
XIAODOU_PRIVATE_KEY_FILE=
XIAODOU_CASHIER_ORIGINS=
XIAODOU_METHODS=
XIAODOU_TRADE_SCOPE=CARD_VIRTUAL
# Example fixed offer (exclusive upper bound, China Standard Time):
# QUANT_PLANS_JSON=[{"id":"plan-2027","title":"Subscription","valid_until":"2027-01-01T00:00:00+08:00","amount_minor":1000,"currency":"CNY"}]
XIANYU_ITEM_URL=

# Put model credentials and policy in ops.env; OPS_AI_ENABLED above stays shared.
# The model is called only for incidents; normal operation has no AI dependency.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
OPS_MAX_CALLS_PER_DAY=10
OPS_AUTO_PARSER_REPAIR=0
OPS_CHECKOUT=

# Separate 32-byte base64 encryption key file; keep a copy OFF the server.
HADAN_BACKUP_KEY_FILE=
HADAN_BACKUP_DIR=
HADAN_BACKUP_GROUP_READ=0
HADAN_BACKUP_REQUIRED=0
HADAN_DRIVE_BACKUP_STATUS=
